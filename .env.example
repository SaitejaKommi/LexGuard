# Example .env for LexGuard
# Copy this to .env and fill with real credentials before deploying.

# Flask
FLASK_ENV=production
SECRET_KEY=replace-me

# MongoDB
MONGO_URI=mongodb+srv://user:pass@cluster0.example.mongodb.net/lexguard

# Gemini / AI provider
GEMINI_API_KEY=

# Google APIs
GOOGLE_TTS_API_KEY=
GOOGLE_SEARCH_API_KEY=

# Firebase (if used locally, keep JSON service account out of git and reference via env)
FIREBASE_SERVICE_ACCOUNT_PATH=./lexguard-xxxx-firebase-adminsdk.json

# CORS origins (comma separated)
CORS_ORIGINS=http://localhost:5000
# LexGuard Environment Variables — Copy to .env and fill in values
SECRET_KEY=
GEMINI_API_KEY=
MONGO_URI=
MONGO_DB_NAME=lexguard
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_TTS_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
MYMEMORY_EMAIL=
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5500
TESSERACT_CMD=
DEBUG=false
